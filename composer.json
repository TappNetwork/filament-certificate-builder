{
    "name": "tapp/filament-certificate-builder",
    "description": "Filament plugin for designing and rendering certificate templates",
    "keywords": [
        "Tapp",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-certificate-builder"
    ],
    "homepage": "https://github.com/TappNetwork/filament-certificate-builder",
    "support": {
        "issues": "https://github.com/TappNetwork/filament-certificate-builder/issues",
        "source": "https://github.com/TappNetwork/filament-certificate-builder"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "John Wesely",
            "email": "john.wesely@tappnetwork.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tapp\\FilamentCertificateBuilder\\": "src/",
            "Tapp\\FilamentCertificateBuilder\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tapp\\FilamentCertificateBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tapp\\FilamentCertificateBuilder\\FilamentCertificateBuilderServiceProvider"
            ],
            "aliases": {
                "FilamentCertificateBuilder": "Tapp\\FilamentCertificateBuilder\\Facades\\FilamentCertificateBuilder"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}